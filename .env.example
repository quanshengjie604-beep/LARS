# Copy to .env and fill in. .env is gitignored; never commit real keys.

# The web-search LLM is queried for EVERY company to fetch its funding rounds and
# whether it is still operating or dissolved (training/both modes; funding rounds
# come from here, not from scraping).

# Default provider: Google Gemini. Set this to enable the query.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.1-flash-lite).
# gemini-3.1-flash-lite offers a balance of capability and throughput.
# Use gemini-3.5-flash for a newer/more capable (but pricier, lower-RPM) model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Alternative provider: OpenAI, selected with the --use-openai flag.
OPENAI_API_KEY=
# Optional: override the OpenAI model (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
